# --- Product ---
NEXT_PUBLIC_PRODUCT_NAME="LeadSprint"
NEXT_PUBLIC_VERTICAL="real-estate"

# --- Database ---
# Local dev (docker-compose postgres service):
DATABASE_URL="postgresql://voiceai:voiceai@postgres:5432/voiceai?schema=public"
# Prod (Supabase, matches Ava's pattern) — use the connection string from
# Supabase > Project Settings > Database > Connection string (use the
# "Transaction" pooler string, port 6543, for serverless-friendly connections):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# --- Mock switch ---
# true  = BolnaService/TwilioService return fake data, no external calls made.
# false = real API calls are made using the keys below. Flip this once you
#         actually have Bolna self-hosted + provider keys.
USE_MOCKS=true
DEFAULT_VOICE_ENGINE=mock

# --- Vapi (fast managed pilot path) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# --- Bolna (self-hosted, bolna-ai/bolna local_setup) ---
# Points at the `bolna-app` container's agent-CRUD server (port 5001,
# verified from their repo — NOT the twilio-app call-handling port 8001).
# No API key for self-hosted; that's Bolna Cloud (api.bolna.ai) only.
BOLNA_API_BASE_URL=http://bolna-app:5001
BOLNA_TELEPHONY_BASE_URL=
BOLNA_OUTBOUND_AGENT_ID=
BOLNA_API_KEY=
BOLNA_FROM_PHONE_NUMBER=
# Shared secret you invent yourself and configure as a custom header
# (X-Webhook-Secret) on Bolna's analytics/callback webhook config, since
# self-hosted Bolna does not sign its webhook payloads. Required before
# taking real calls — see src/app/api/webhooks/bolna/route.ts.
BOLNA_WEBHOOK_SECRET=

# --- Providers Bolna calls internally (only needed if you bypass Bolna
# and call them directly, e.g. for a custom STT/TTS fallback path) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used to verify X-Twilio-Signature on inbound webhooks. Get this from
# Twilio Console > Account > API keys & tokens.
TWILIO_AUTH_TOKEN_SIGNING=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
AUTH_SECRET=replace-with-a-long-random-secret

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
LOGTAIL_TOKEN=
BETTERSTACK_SOURCE_TOKEN=

# --- Data retention cron ---
# Shared secret for POST /api/cron/retention (serverless deploys only —
# Docker/VPS deploys should use `node scripts/retention-cleanup.mjs` via
# a real crontab instead, see PRODUCTION_SETUP.md).
CRON_SECRET=

# --- WhatsApp provider placeholder ---
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
