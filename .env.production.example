# Copy to .env on the server. Do not commit the real .env.

NODE_ENV=production
NEXT_PUBLIC_PRODUCT_NAME="LeadSprint"
NEXT_PUBLIC_VERTICAL="real-estate"
NEXT_PUBLIC_APP_URL=https://your-domain.com
PORT=3000
AUTH_SECRET=replace-with-a-long-random-secret

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
LOGTAIL_TOKEN=
BETTERSTACK_SOURCE_TOKEN=

# Required in production
DATABASE_URL="postgresql://voiceai:CHANGE_ME@postgres:5432/voiceai?schema=public"

# Voice engine: mock | vapi | bolna
DEFAULT_VOICE_ENGINE=mock
USE_MOCKS=false

# Vapi managed call path
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# Bolna self-hosted call path
BOLNA_API_BASE_URL=http://bolna-app:5001
BOLNA_TELEPHONY_BASE_URL=
BOLNA_OUTBOUND_AGENT_ID=
BOLNA_API_KEY=
BOLNA_FROM_PHONE_NUMBER=

# LLM/STT/TTS provider keys used by your selected voice stack
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AUTH_TOKEN_SIGNING=

# India telephony alternative
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# WhatsApp Business API
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
